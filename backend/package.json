{
  "name": "trustride-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Secure & Accountable Remote Immobilization Platform - backend (simulation, no real hardware)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:edge": "vitest run test/edge-cases",
    "test:integration": "vitest run test/integration",
    "test:scenarios": "vitest run test/integration/scenarios.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
